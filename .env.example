# Copy to .env and fill with your Lovable Cloud project values.
# All values below are PUBLISHABLE (safe for client bundles).
# NEVER put SUPABASE_SERVICE_ROLE_KEY or any private secret in this file
# — use the Lovable secrets tooling instead.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=