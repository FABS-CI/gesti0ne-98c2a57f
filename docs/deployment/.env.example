# ============================================================
# ERP Gesti0ne — Modèle de variables d'environnement
# ============================================================
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS commit le .env dans Git.
# ============================================================

# --- Supabase (côté client, exposées au navigateur) ---
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=xxxxxxxxxx

# --- Supabase (côté serveur uniquement) ---
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=xxxxxxxxxx

# ⚠️ CRITIQUE — Service Role bypasse RLS. NE JAMAIS exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# --- FNE (facturation électronique CI) — si utilisé ---
# FNE_API_KEY=
# FNE_API_URL=

# --- Email transactionnel — si utilisé ---
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- SMS — si utilisé ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- IA (remplacer Lovable AI Gateway si vous l'utilisiez) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Webhooks (signature HMAC) ---
# À générer avec: openssl rand -hex 32
# WEBHOOK_SECRET=

# --- Divers ---
NODE_ENV=production
TZ=UTC
